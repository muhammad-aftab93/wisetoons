{
  "expo": {
    "name": "WiseToons for Kids",
    "slug": "wisetoons",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EAF2FF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wisetoons.kids",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.wisetoons.kids",
      "versionCode": 2,
      "backgroundColor": "#EAF2FF",
      "adaptiveIcon": {
        "backgroundColor": "#1B1931",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF2FF"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EAF2FF"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1724311042546242~2819526958",
          "iosAppId": "ca-app-pub-1724311042546242~2819526958",
          "userTrackingUsageDescription": "This app uses family-safe advertising to keep learning fun and free for kids."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bd8522a1-59da-459f-bb51-78080402172e"
      }
    },
    "owner": "devexpo93s-team"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1724311042546242~2819526958",
    "ios_app_id": "ca-app-pub-1724311042546242~2819526958",
    "user_tracking_usage_description": "This app uses family-safe advertising to keep learning fun and free for kids."
  }
}
